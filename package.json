{
  "name": "shia-songs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs && node tests/motion-browser.mjs && node tests/vinyl-bilingual-browser.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.0",
    "pg": "8.23.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.27.4",
    "jsdom": "30.1.1",
    "playwright": "1.63.0"
  }
}
