{
  "name": "shia-songs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "inquiries:review": "node --env-file-if-exists=.env server/review-inquiry.js",
    "notifications:work": "node --env-file-if-exists=.env server/notification-worker.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:edge:deno": "deno check supabase/functions/shia-order-intake-v2/index.ts supabase/functions/shia-song-payments/index.ts supabase/functions/shia-stripe-webhook/index.ts supabase/functions/shia-song-notifications/index.ts && deno test tests/edge-deno.test.ts",
    "test:edge:browser": "node tests/edge-browser.mjs",
    "test:browser": "node tests/browser.mjs && node tests/motion-browser.mjs && node tests/vinyl-bilingual-browser.mjs && node tests/hero-refinement-browser.mjs && node tests/intake-browser.mjs && node tests/edge-browser.mjs",
    "check": "npm run build && npm test && npm run test:edge:deno && npm run test:browser",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.0",
    "pg": "8.23.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.5.8",
    "deno": "2.5.2",
    "esbuild": "0.27.4",
    "jsdom": "30.1.1",
    "playwright": "1.63.0"
  }
}
