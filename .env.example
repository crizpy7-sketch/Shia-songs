# Local preview works with ALL values below blank/default. No live transactions supported.
PORT=3000
APP_ORIGIN=http://localhost:3000
CHECKOUT_ENABLED=false
# Provision only through user-approved secure setup. Prefer a restricted sandbox API key.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SONGS=
STRIPE_PRICE_SLIDESHOW=
DATABASE_URL=
INTAKE_BRIDGE_SECRET=
PAYMENT_TOKEN_SECRET=
INTAKE_BRIDGE_READY=false
COMMERCIAL_TERMS_APPROVED=false
COMMERCIAL_TERMS_URL=
TAX_REVIEWED=false

# Isolated intake is opt-in. Static GitHub Pages keeps the existing edge intake.
INTAKE_ENABLED=false
INTAKE_TOKEN_SECRET=
# Optional private upload bucket in a NEW / approved SHIA-only project.
# The existing shared bjnkgxkcbbnbtazelsjs project is explicitly refused.
SHIA_STORAGE_URL=
SHIA_STORAGE_SERVICE_KEY=
SHIA_STORAGE_BUCKET=
# Alerts: choose resend OR webhook. All destinations remain unset.
NOTIFICATION_PROVIDER=
NOTIFICATION_FROM=
NOTIFICATION_TO=
RESEND_API_KEY=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Only true after receiver confirms durable Idempotency-Key deduplication.
NOTIFICATION_WEBHOOK_IDEMPOTENT=false
# Production container only, behind a trusted same-origin HTTPS proxy:
HOST=127.0.0.1
